---
import Base from '../layouts/Base.astro';

const projects = [
  {
    number: '01',
    type: 'Analytics POC',
    title: 'Measuring the last meaningful second',
    subtitle: 'Engaged dwell time without betting on unload events.',
    description: 'A heartbeat and delayed-events model that keeps updating an engagement snapshot, then flushes the final state only after the client goes quiet.',
    tags: ['Browser SDK', 'Event delivery', 'State machines'],
    href: 'https://mercy811.github.io/amplitude-engaged-dwell-poc/',
    source: 'https://github.com/Mercy811/amplitude-engaged-dwell-poc',
    tone: 'lime',
    visual: 'heartbeat',
  },
  {
    number: '02',
    type: 'Analytics POC',
    title: 'AutoCapture beyond the light DOM',
    subtitle: 'What breaks in shadow trees—and how to recover the signal.',
    description: 'A slide walkthrough and interactive test bench for click and form tracking across open, closed, and nested Shadow DOM boundaries.',
    tags: ['AutoCapture', 'Shadow DOM', 'Web platform'],
    href: 'https://mercy811.github.io/shadow-dom-autocapture-poc/',
    source: 'https://github.com/Mercy811/shadow-dom-autocapture-poc',
    tone: 'violet',
    visual: 'shadow',
  },
  {
    number: '03',
    type: 'Systems explainer',
    title: 'Mapping iOS mobile attribution',
    subtitle: 'A visual model of a deliberately opaque ecosystem.',
    description: 'An interactive explainer for reasoning about the actors, hand-offs, and constraints inside the iOS mobile attribution network.',
    tags: ['iOS', 'Attribution', 'Interactive explainer'],
    href: 'https://mercy811.github.io/ios-mobile-attribution-network/',
    source: 'https://github.com/Mercy811/ios-mobile-attribution-network',
    tone: 'orange',
    visual: 'network',
  },
  {
    number: '04',
    type: 'Side project',
    title: 'Learn Thai through the songs you love',
    subtitle: 'From passive listening to line-by-line practice.',
    description: 'A language-learning playground with synchronized lyrics, word-level meanings and pronunciation, KTV mode, quizzes, memory lessons, and vocabulary coverage.',
    tags: ['Language learning', 'Product design', 'JavaScript'],
    href: 'https://thai-song-learner.vercel.app/',
    source: 'https://github.com/Mercy811/thai-song-learner',
    tone: 'blue',
    visual: 'lyrics',
  },
];
---

<Base>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Engineer · builder · curious observer</p>
      <h1>I make invisible systems <em>visible.</em></h1>
      <p class="lede">I’m Xinyi. I build analytics SDKs, prototypes, and small products that turn fuzzy behavior into something we can inspect, question, and improve.</p>
      <div class="hero-actions">
        <a class="button dark" href="#work">Explore the work ↓</a>
        <a class="text-link" href="https://github.com/Mercy811" target="_blank" rel="noreferrer">Follow the code ↗</a>
      </div>
    </div>
    <div class="signal-card" aria-label="Decorative analytics signal visualization">
      <div class="signal-head"><span>LIVE SIGNAL</span><span class="live-dot">capturing</span></div>
      <div class="plot">
        <div class="axis-label y">ENGAGEMENT</div>
        <svg viewBox="0 0 520 250" role="img" aria-label="An abstract rising engagement signal">
          <path class="grid" d="M0 42H520M0 94H520M0 146H520M0 198H520M65 0V250M130 0V250M195 0V250M260 0V250M325 0V250M390 0V250M455 0V250" />
          <path class="signal" d="M0 210 C35 207,45 180,75 183 S120 205,145 170 S180 120,210 143 S250 180,278 122 S325 52,356 78 S395 146,420 89 S470 36,520 48" />
          <circle cx="520" cy="48" r="6" />
        </svg>
        <div class="axis-label x">TIME →</div>
      </div>
      <div class="signal-foot"><span>page_view.completed</span><strong>47.8s</strong></div>
    </div>
  </section>

  <section class="ticker" aria-label="Areas of interest">
    <div>ANALYTICS SYSTEMS <span>✳</span> BROWSER SIGNALS <span>✳</span> PRODUCT EXPERIMENTS <span>✳</span> LEARNING TOOLS <span>✳</span> ANALYTICS SYSTEMS</div>
  </section>

  <section class="work shell" id="work">
    <div class="section-intro">
      <div><p class="eyebrow">Selected experiments · 2026</p><h2>Work in public</h2></div>
      <p>Proofs of concept are how I think: make the mechanism tangible, expose the trade-offs, and give people something they can poke.</p>
    </div>
    <div class="project-list">
      {projects.map((project) => (
        <article class="project">
          <div class="project-meta"><span>{project.number}</span><span>{project.type}</span></div>
          <div class={`project-visual ${project.tone}`}>
            {project.visual === 'heartbeat' && <><div class="pulse-line"></div><div class="metric"><span>heartbeat</span><strong>01.0s</strong></div><div class="metric bottom"><span>flush after</span><strong>10.0s</strong></div></>}
            {project.visual === 'shadow' && <div class="shadow-stack"><i></i><i></i><i></i><b>event<br/>path</b></div>}
            {project.visual === 'network' && <div class="network"><i></i><i></i><i></i><i></i><span>install</span><span>ad</span><span>signal</span></div>}
            {project.visual === 'lyrics' && <div class="lyrics"><span>ชอบตัวเอง</span><span>chɔ̂ɔp dtua-eeng</span><span>I like myself</span><div class="sound-bars">▂▄▆█▆▃▅▇▅▂</div></div>}
          </div>
          <div class="project-copy">
            <p class="eyebrow">{project.subtitle}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <ul>{project.tags.map((tag) => <li>{tag}</li>)}</ul>
            <div class="links"><a href={project.href} target="_blank" rel="noreferrer">Open project ↗</a>{project.source && <a href={project.source} target="_blank" rel="noreferrer">Source ↗</a>}</div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="thoughts shell" id="thoughts">
    <div class="section-intro"><div><p class="eyebrow">Notes from the workbench</p><h2>Working thoughts</h2></div><p>Short essays about measurement, system behavior, and what changes once an idea meets a browser.</p></div>
    <div class="note-grid">
      <a href="/thoughts/who-owns-domain-gating/"><span class="eyebrow">Analytics architecture · 7 min</span><h3>Who should stop analytics from running on the wrong domain?</h3><p>Copied snippets expose a boundary between customer configuration and platform responsibility.</p><b>Read note →</b></a>
      <a href="/thoughts/analytics-as-state-machines/"><span class="eyebrow">Analytics systems · 6 min</span><h3>Analytics is less about events than state transitions</h3><p>Why “send an event” is often the least interesting part of reliable measurement.</p><b>Read note →</b></a>
      <a href="/thoughts/building-thai-song-learner/"><span class="eyebrow">Side projects · 5 min</span><h3>Building the tool I wanted as a Thai learner</h3><p>Designing for the five minutes between hearing a line and being able to sing it.</p><b>Read note →</b></a>
    </div>
  </section>

  <section class="about shell" id="about">
    <p class="eyebrow">About</p>
    <div><h2>I like the layer where product questions become engineering constraints.</h2><div class="about-copy"><p>My work sits around analytics SDKs and the browser: lifecycle edges, event semantics, automatic capture, and the places where “obvious” data becomes surprisingly hard to measure.</p><p>This site is my public workbench—part demo shelf, part notebook. Everything here is built to make a technical idea easier to see and discuss.</p><a href="https://github.com/Mercy811" target="_blank" rel="noreferrer">github.com/Mercy811 ↗</a></div></div>
  </section>
</Base>

<style>
  .hero { min-height: 670px; padding: 86px 0 110px; display: grid; grid-template-columns: 1.08fr .92fr; gap: 70px; align-items: center; }
  h1 { max-width: 700px; margin: 20px 0 26px; font: 500 clamp(62px, 7.3vw, 106px)/.82 var(--serif); letter-spacing: -.065em; }
  h1 em { color: var(--violet); font-weight: 400; }
  .lede { max-width: 640px; color: #39403b; font-size: 19px; }
  .hero-actions { display: flex; gap: 28px; align-items: center; margin-top: 36px; }
  .button { padding: 13px 19px; text-decoration: none; border-radius: 3px; font: 500 12px var(--mono); }
  .button.dark { background: var(--ink); color: white; }
  .text-link { font: 500 12px var(--mono); text-underline-offset: 5px; }
  .signal-card { background: var(--ink); color: #eef1ec; transform: rotate(1.5deg); box-shadow: 14px 14px 0 var(--acid); }
  .signal-head, .signal-foot { display: flex; justify-content: space-between; align-items: center; padding: 16px 18px; font: 11px var(--mono); }
  .signal-head { border-bottom: 1px solid #465048; }
  .signal-foot { border-top: 1px solid #465048; }
  .signal-foot strong { color: var(--acid); font-size: 17px; }
  .live-dot:before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--acid); margin-right: 7px; box-shadow: 0 0 0 5px #d8ff6320; }
  .plot { position: relative; padding: 32px 22px 25px 44px; }
  .plot svg { display: block; width: 100%; overflow: visible; }
  .grid { stroke: #343c36; stroke-width: 1; fill: none; }
  .signal { stroke: var(--acid); stroke-width: 4; fill: none; }
  .plot circle { fill: var(--acid); }
  .axis-label { position: absolute; color: #879088; font: 9px var(--mono); letter-spacing: .1em; }
  .axis-label.y { left: 8px; top: 50%; transform: rotate(-90deg); }
  .axis-label.x { right: 20px; bottom: 8px; }
  .ticker { overflow: hidden; border-block: 1px solid var(--ink); padding: 13px 0; font: 500 11px var(--mono); white-space: nowrap; }
  .ticker div { width: max-content; animation: crawl 24s linear infinite; }
  .ticker span { margin: 0 28px; color: var(--violet); }
  @keyframes crawl { to { transform: translateX(-40%); } }
  .work, .thoughts { padding-top: 110px; }
  .section-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; padding-bottom: 42px; border-bottom: 1px solid var(--line); }
  .section-intro h2, .about h2 { margin: 12px 0 0; font: 500 clamp(44px, 6vw, 72px)/.95 var(--serif); letter-spacing: -.045em; }
  .section-intro > p { max-width: 480px; margin: 0 0 6px; color: var(--muted); }
  .project { display: grid; grid-template-columns: 100px minmax(320px, .85fr) 1.15fr; gap: 40px; padding: 50px 0; border-bottom: 1px solid var(--line); }
  .project-meta { display: flex; flex-direction: column; gap: 8px; font: 10px var(--mono); color: var(--muted); text-transform: uppercase; }
  .project-visual { position: relative; min-height: 310px; overflow: hidden; border-radius: 2px; }
  .lime { background: var(--acid); } .violet { background: var(--violet); } .orange { background: var(--orange); } .blue { background: #8ed8ff; }
  .project-copy { padding: 12px 0; }
  .project-copy h3 { font: 500 clamp(34px, 4vw, 54px)/1 var(--serif); letter-spacing: -.035em; margin: 14px 0 18px; max-width: 570px; }
  .project-copy > p:not(.eyebrow) { max-width: 600px; color: #4c544e; font-size: 16px; }
  .project-copy ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 25px 0; }
  .project-copy li { border: 1px solid #aeb5ad; border-radius: 100px; padding: 5px 10px; font: 10px var(--mono); }
  .links { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .links a { font: 500 12px var(--mono); text-underline-offset: 5px; }
  .links small { color: var(--muted); font: 10px var(--mono); }
  .metric { position: absolute; left: 24px; top: 22px; font: 11px var(--mono); }
  .metric strong, .metric span { display: block; }.metric strong { font-size: 28px; margin-top: 3px; }.metric.bottom { top: auto; bottom: 22px; right: 24px; left: auto; text-align: right; }
  .pulse-line { position: absolute; inset: 48% 0 auto; height: 3px; background: var(--ink); }
  .pulse-line:after { content: ''; position: absolute; left: 30%; top: -48px; width: 120px; height: 95px; border: solid var(--ink); border-width: 3px 3px 0 0; transform: skewX(-25deg) rotate(45deg); }
  .shadow-stack i { position: absolute; width: 58%; height: 48%; border: 2px solid var(--ink); background: #ffffff20; left: 21%; top: 24%; transform: rotate(-4deg); }.shadow-stack i:nth-child(2) { transform: translate(18px,-16px) rotate(3deg); }.shadow-stack i:nth-child(3) { transform: translate(36px,-32px) rotate(8deg); }.shadow-stack b { position: absolute; bottom: 28px; left: 30px; font: 500 28px/1 var(--mono); }
  .network i { position: absolute; width: 18px; height: 18px; background: var(--ink); border-radius: 50%; }.network i:nth-child(1){left:16%;top:24%}.network i:nth-child(2){right:16%;top:20%}.network i:nth-child(3){left:32%;bottom:18%}.network i:nth-child(4){right:25%;bottom:30%}.network:before,.network:after{content:'';position:absolute;left:18%;top:28%;width:68%;height:1px;background:var(--ink);transform:rotate(21deg);transform-origin:left}.network:after{transform:rotate(-18deg);top:72%}.network span{position:absolute;font:10px var(--mono);}.network span:nth-of-type(1){left:12%;top:14%}.network span:nth-of-type(2){right:13%;top:12%}.network span:nth-of-type(3){right:17%;bottom:18%}
  .lyrics { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }.lyrics span:first-child{font:500 36px var(--sans)}.lyrics span:nth-child(2){font:13px var(--mono);margin-top:10px}.lyrics span:nth-child(3){font:500 14px var(--serif);margin-top:8px}.sound-bars{position:absolute;bottom:24px;font:20px var(--mono);letter-spacing:4px}
  .thoughts { padding-bottom: 90px; }
  .note-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border-bottom: 1px solid var(--line); }
  .note-grid a { padding: 42px 38px; background: var(--paper); text-decoration: none; }
  .note-grid a:hover { background: var(--card); }
  .note-grid h3 { font: 500 36px/1.08 var(--serif); letter-spacing: -.025em; margin: 22px 0 16px; }
  .note-grid p { color: var(--muted); max-width: 500px; }
  .note-grid b { display: inline-block; margin-top: 18px; font: 500 11px var(--mono); }
  .about { padding: 90px 0; border-top: 1px solid var(--ink); }
  .about > div { display: grid; grid-template-columns: 1.2fr .8fr; gap: 90px; margin-top: 25px; }
  .about h2 { max-width: 700px; }
  .about-copy { padding-top: 10px; color: #434a45; }
  .about-copy a { display: inline-block; margin-top: 14px; font: 500 12px var(--mono); text-underline-offset: 5px; }
  @media (max-width: 850px) {
    .hero { grid-template-columns: 1fr; padding-top: 70px; }.signal-card { max-width: 560px; }.project { grid-template-columns: 55px 1fr; }.project-visual { grid-column: 2; }.project-copy { grid-column: 2; }.about > div { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 600px) {
    .hero { min-height: auto; padding: 60px 0 80px; }.hero-actions { align-items: flex-start; flex-direction: column; }.section-intro { grid-template-columns: 1fr; }.project { display: block; }.project-meta { flex-direction: row; justify-content: space-between; margin-bottom: 16px; }.project-visual { min-height: 260px; }.project-copy { padding-top: 28px; }.note-grid { grid-template-columns: 1fr; }.note-grid a { padding: 34px 12px; }.about { padding: 68px 0; }
  }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; animation: none !important; } }
</style>
