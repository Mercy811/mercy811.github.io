00%;height:min(78vh,780px);display:block;border:0}.video-frame{aspect-ratio:16/9;box-shadow:12px 12px 0 #ffb4cf}.video-frame iframe{width:100%;height:100%;display:block;border:0}.takeaway{margin-top:110px}.takeaway blockquote{font:500 clamp(44px,6vw,76px)/.98 var(--serif);letter-spacing:-.045em;margin:0}.takeaway>p:last-child{grid-column:2;max-width:640px;color:var(--muted);font-size:18px}@media(max-width:800px){.hero-grid,.problem,.takeaway,.section-head{grid-template-columns:1fr;gap:25px}.steps li{grid-template-columns:42px 1fr}.steps p{grid-column:2}.actions{justify-content:flex-start}.project-hero{padding-top:45px}.demo-frame iframe{height:660px}.takeaway>p:last-child{grid-column:1}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>

