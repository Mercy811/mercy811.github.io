---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} — ThaiCue product notes`} description={frontmatter.description}>
  <article class="prose thaicue-note">
    <a class="back" href="/projects/thaicue/">← All ThaiCue product notes</a>
    <p class="eyebrow">ThaiCue product note · {frontmatter.date}</p>
    <h1>{frontmatter.title}</h1>
    <p class="dek">{frontmatter.description}</p>
    <div class="rule"></div>
    <slot />
  </article>
</Base>

<style>
  .back { display: inline-block; margin-bottom: 70px; color: var(--muted); font: 11px var(--mono); text-underline-offset: 5px; }
  .dek { font: 400 22px/1.5 var(--serif) !important; color: var(--muted) !important; }
  .rule { width: 100px; height: 5px; margin: 38px 0 50px; background: #8ed8ff; }
  :global(.thaicue-note blockquote) { margin: 34px 0; padding: 2px 0 2px 24px; border-left: 4px solid #8ed8ff; }
  :global(.thaicue-note blockquote p) { font: 400 21px/1.55 var(--serif); }
</style>
