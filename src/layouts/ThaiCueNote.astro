---
import Base from './Base.astro';
import LanguageToggle from '../components/LanguageToggle.astro';

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} — ThaiCue product notes`} description={frontmatter.description} titleZh={`${frontmatter.titleZh} — ThaiCue 产品思考`} descriptionZh={frontmatter.descriptionZh}>
  <article class="prose thaicue-note">
    <div class="note-tools">
      <a class="back" href="/projects/thaicue/"><span data-lang="en">← All ThaiCue product notes</span><span data-lang="zh">← 返回所有 ThaiCue 产品思考</span></a>
      <LanguageToggle />
    </div>
    <p class="eyebrow"><span data-lang="en">ThaiCue product note · {frontmatter.date}</span><span data-lang="zh">ThaiCue 产品思考 · {frontmatter.dateZh}</span></p>
    <h1><span data-lang="en">{frontmatter.title}</span><span data-lang="zh">{frontmatter.titleZh}</span></h1>
    <p class="dek"><span data-lang="en">{frontmatter.description}</span><span data-lang="zh">{frontmatter.descriptionZh}</span></p>
    <div class="rule"></div>
    <slot />
  </article>
</Base>

<style>
  .note-tools { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 70px; }
  .back { color: var(--muted); font: 11px var(--mono); text-underline-offset: 5px; }
  .dek { font: 400 22px/1.5 var(--serif) !important; color: var(--muted) !important; }
  .rule { width: 100px; height: 5px; margin: 38px 0 50px; background: #8ed8ff; }
  :global(.thaicue-note blockquote) { margin: 34px 0; padding: 2px 0 2px 24px; border-left: 4px solid #8ed8ff; }
  :global(.thaicue-note blockquote p) { font: 400 21px/1.55 var(--serif); }
</style>
