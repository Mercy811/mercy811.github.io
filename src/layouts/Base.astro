---
interface Props {
  title?: string;
  description?: string;
  titleZh?: string;
  descriptionZh?: string;
}

const {
  title = 'Xinyi Ye — analytics, prototypes, and experiments',
  description = 'A working notebook of analytics engineering proofs of concept, product experiments, and side projects by Xinyi Ye.',
  titleZh,
  descriptionZh,
} = Astro.props;

const bilingual = Boolean(titleZh && descriptionZh);
---

<!doctype html>
<html lang="en" data-language="en" data-bilingual={bilingual ? 'true' : undefined} data-title-en={title} data-title-zh={titleZh} data-description-en={description} data-description-zh={descriptionZh}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="Xinyi Ye, home"><span>XY</span> Xinyi Ye</a>
      <nav aria-label="Primary navigation">
        <a href="/#work"><span data-lang="en">Work</span><span data-lang="zh">作品</span></a>
        <a href="/#thoughts"><span data-lang="en">Thoughts</span><span data-lang="zh">思考</span></a>
        <a href="/#about"><span data-lang="en">About</span><span data-lang="zh">关于</span></a>
        <a class="github-link" href="https://github.com/Mercy811" target="_blank" rel="noreferrer">GitHub ↗</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer shell">
      <p><span data-lang="en">Built as a living notebook, not a finished archive.</span><span data-lang="zh">这是一本持续生长的笔记，而不是一份已经完成的档案。</span></p>
      <p>© {new Date().getFullYear()} Xinyi Ye</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #151a17;
    --muted: #5f665f;
    --paper: #f3f0e8;
    --card: #fbf9f3;
    --line: #c9cec4;
    --acid: #d8ff63;
    --violet: #7467ff;
    --orange: #ff7043;
    --mono: 'DM Mono', monospace;
    --sans: 'Manrope', sans-serif;
    --serif: 'Newsreader', serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--paper); }
  body { margin: 0; color: var(--ink); font-family: var(--sans); line-height: 1.55; }
  a { color: inherit; }
  html:not([data-language="zh"]) [data-lang="zh"],
  html[data-language="zh"] [data-lang="en"] { display: none !important; }
  .shell { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
  .site-header { height: 84px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .wordmark { display: flex; gap: 11px; align-items: center; text-decoration: none; font-weight: 700; }
  .wordmark span { display: grid; place-items: center; width: 34px; height: 34px; background: var(--ink); color: var(--acid); border-radius: 50%; font: 500 12px var(--mono); }
  nav { display: flex; align-items: center; gap: 30px; font: 400 13px var(--mono); }
  nav a { text-decoration: none; }
  nav a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .github-link { padding: 9px 14px; border: 1px solid var(--ink); border-radius: 100px; }
  .site-footer { margin-top: 100px; padding: 28px 0 44px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; color: var(--muted); font: 12px var(--mono); }
  .prose { width: min(720px, calc(100% - 40px)); margin: 72px auto; }
  .prose h1 { font: 500 clamp(42px, 7vw, 74px)/.98 var(--serif); letter-spacing: -.04em; margin: 18px 0 28px; }
  .prose h2 { font: 500 32px/1.1 var(--serif); margin-top: 52px; }
  .prose p, .prose li { font-size: 17px; color: #303632; }
  .prose a { text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .eyebrow { font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: .13em; color: var(--muted); }
  @media (max-width: 700px) {
    .shell { width: min(100% - 24px, 1180px); }
    .site-header { height: 68px; }
    nav a:not(.github-link) { display: none; }
    .github-link { padding: 7px 11px; }
    .site-footer { align-items: flex-start; gap: 16px; flex-direction: column; }
  }
</style>
